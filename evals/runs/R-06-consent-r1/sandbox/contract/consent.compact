pragma language_version >= 0.20;

import CompactStandardLibrary;

export ledger consents: HistoricMerkleTree<10, Bytes<32>>;
export ledger revoked: Set<Bytes<32>>;
export ledger answered: Map<Bytes<32>, Bytes<32>>;
export ledger registrations: Counter;

witness consentSecret(): Bytes<32>;
witness consentRandomness(): Bytes<32>;
witness consentPath(commitment: Bytes<32>): MerkleTreePath<10, Bytes<32>>;

// Leaf stored in the tree: hides studyId, secret and randomness.
circuit commitmentOf(studyId: Bytes<32>, secret: Bytes<32>, rand: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>(
    [pad(32, "consent:commit:v1"), studyId, secret, rand]);
}

// Revocation tag: derived from secret + study only; unlinkable to the leaf
// without the secret, and the secret itself is never revealed.
circuit revocationTag(studyId: Bytes<32>, secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "consent:revoke:v1"), studyId, secret]);
}

// Asserts the caller's registration for studyId is in the tree; returns the leaf.
circuit requireRegistered(studyId: Bytes<32>): Bytes<32> {
  const leaf = commitmentOf(studyId, consentSecret(), consentRandomness());
  const path = consentPath(leaf);
  assert(path.leaf == leaf, "Path does not match registration");
  assert(consents.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))),
         "Registration not found");
  return leaf;
}

export circuit register(studyId: Bytes<32>): [] {
  const leaf = commitmentOf(studyId, consentSecret(), consentRandomness());
  consents.insert(disclose(leaf));
  registrations.increment(1);
}

export circuit prove(studyId: Bytes<32>, challenge: Bytes<32>): []  {
  assert(!answered.member(disclose(challenge)), "Challenge already answered");
  requireRegistered(studyId);
  const tag = revocationTag(studyId, consentSecret());
  assert(!revoked.member(disclose(tag)), "Consent revoked");
  answered.insert(disclose(challenge), disclose(studyId));
}

export circuit revoke(studyId: Bytes<32>): [] {
  requireRegistered(studyId);
  revoked.insert(disclose(revocationTag(studyId, consentSecret())));
}
