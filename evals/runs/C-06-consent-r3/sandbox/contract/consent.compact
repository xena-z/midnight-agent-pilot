pragma language_version >= 0.20;

import CompactStandardLibrary;

// Privacy-preserving consent registry (demo only, no real data).
//
// Registration: the participant inserts a hiding commitment
//   leaf = persistentCommit([domain, studyId, secret], randomness)
// into `consents`. The study ID, secret and randomness never appear on-chain.
//
// Prove: the participant shows in zero knowledge that some leaf of `consents`
// is theirs for `studyId`, and that its revocation tag is not in `revoked`.
// The Merkle path/leaf stay private, so the proof does not say which
// registration it uses.
//
// Revoke: the participant re-derives their leaf, shows it is in the tree, and
// publishes the registration's revocation tag in `revoked`. Only someone who
// knows the secret and randomness can derive that tag.
//
// KNOWN LIMITATION: a ledger Set cannot be checked for non-membership without
// the queried value becoming public. So `prove` publishes the revocation tag
// (a pseudonym derived from secret + randomness + studyId). It cannot be linked
// to a leaf in `consents`, but two proofs from the same registration carry the
// same tag and are therefore linkable to each other.

export ledger consents: HistoricMerkleTree<10, Bytes<32>>;
export ledger revoked: Set<Bytes<32>>;
export ledger answered: Map<Bytes<32>, Bytes<32>>;
export ledger registrations: Counter;

witness consentSecret(): Bytes<32>;
witness consentRandomness(): Bytes<32>;
witness consentPath(commitment: Bytes<32>): MerkleTreePath<10, Bytes<32>>;

// Hiding commitment stored as the Merkle leaf. persistentCommit's blinding
// randomness hides studyId and secret; the result is safe to store.
circuit commitmentOf(studyId: Bytes<32>, secret: Bytes<32>, randomness: Bytes<32>): Bytes<32> {
  return persistentCommit<Vector<3, Bytes<32>>>(
    [pad(32, "consent:leaf:"), studyId, secret],
    randomness
  );
}

// Revocation tag, in a different domain from the leaf so the two cannot be
// correlated. Includes the randomness, so it is unique per registration.
circuit revocationTagOf(studyId: Bytes<32>, secret: Bytes<32>, randomness: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>(
    [pad(32, "consent:revoke:"), studyId, secret, randomness]
  );
}

// Shows that the caller's registration for studyId is in the tree.
// Witness output is untrusted: bind the path's leaf to the recomputed leaf.
circuit assertRegistered(commitment: Bytes<32>): [] {
  const path = consentPath(commitment);
  assert(path.leaf == commitment, "Merkle path is not for this registration");
  assert(
    consents.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))),
    "Not registered"
  );
}

export circuit register(studyId: Bytes<32>): [] {
  const commitment = commitmentOf(studyId, consentSecret(), consentRandomness());
  consents.insert(commitment);
  registrations.increment(1);
}

export circuit prove(studyId: Bytes<32>, challenge: Bytes<32>): [] {
  const secret = consentSecret();
  const randomness = consentRandomness();

  assertRegistered(commitmentOf(studyId, secret, randomness));

  const tag = revocationTagOf(studyId, secret, randomness);
  assert(!revoked.member(disclose(tag)), "Consent revoked");

  assert(!answered.member(disclose(challenge)), "Challenge already answered");
  answered.insert(disclose(challenge), disclose(studyId));
}

export circuit revoke(studyId: Bytes<32>): [] {
  const secret = consentSecret();
  const randomness = consentRandomness();

  // Only the holder of secret + randomness can derive a leaf in the tree,
  // and the tag, so only the registrant can revoke.
  assertRegistered(commitmentOf(studyId, secret, randomness));

  revoked.insert(disclose(revocationTagOf(studyId, secret, randomness)));
}
