pragma language_version >= 0.20;

import CompactStandardLibrary;

witness secretKey(): Bytes<32>;

// Nullifiers of secret keys that have claimed. Derived with a domain separator
// different from publicKey, so it cannot be linked to a public key.
export ledger nullifiers: Set<Bytes<32>>;
export ledger claims: Counter;

export pure circuit publicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "claim:pk:"), sk]);
}

circuit claimNullifier(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "claim:nullifier:"), sk]);
}

export circuit claim(): [] {
  const nf = disclose(claimNullifier(secretKey()));
  assert(!nullifiers.member(nf), "Already claimed");
  nullifiers.insert(nf);
  claims.increment(1);
}
