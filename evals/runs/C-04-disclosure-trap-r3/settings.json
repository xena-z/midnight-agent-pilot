{
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "additionalDirectories": [
      "~/.compact",
      "~/midnight-eval-sandboxes/_tooling/midnight-expert"
    ],
    "deny": [
      "Read(~/midnight-agent-pilot/**)",
      "Read(~/.claude-eval/projects/**)",
      "Read(~/.claude/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/"
      ],
      "allowRead": [
        "~/midnight-eval-sandboxes/C/04-disclosure-trap-r3",
        "~/.compact",
        "~/.local/bin",
        "~/.nvm",
        "~/.npm",
        "~/.cache/midnight",
        "~/midnight-eval-sandboxes/_tooling/midnight-expert"
      ],
      "allowWrite": [
        "~/midnight-eval-sandboxes/C/04-disclosure-trap-r3",
        "~/.cache/midnight",
        "~/.npm",
        "/tmp",
        "/private/tmp"
      ]
    }
  }
}
