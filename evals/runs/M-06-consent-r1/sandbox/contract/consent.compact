pragma language_version >= 0.28;

import CompactStandardLibrary;

// Privacy-preserving consent registry (demo, no real data).

export ledger consents: HistoricMerkleTree<10, Bytes<32>>;
export ledger revoked: Set<Bytes<32>>;
export ledger answered: Map<Bytes<32>, Bytes<32>>;
export ledger registrations: Counter;

witness consentSecret(): Bytes<32>;
witness consentRandomness(): Bytes<32>;
witness consentPath(commitment: Bytes<32>): MerkleTreePath<10, Bytes<32>>;

// Hiding commitment to (studyId, secret), blinded by the participant's randomness.
// This is the Merkle leaf; it reveals neither studyId, secret nor randomness.
circuit commitmentOf(studyId: Bytes<32>): Bytes<32> {
  return persistentCommit<Vector<2, Bytes<32>>>(
    [studyId, consentSecret()],
    consentRandomness()
  );
}

// Per-(study, participant) revocation tag. Deterministic, so it can be checked
// against `revoked`; derived from the secret, so only the participant can compute it.
// It does not include the randomness, so it cannot be linked to the leaf publicly.
circuit revocationTag(studyId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "consent:revoke:v1"), studyId, consentSecret()]
  );
}

// Asserts that the caller's registration for studyId is in the tree.
circuit assertRegistered(studyId: Bytes<32>): [] {
  const commitment = commitmentOf(studyId);
  const path = consentPath(commitment);
  assert(path.leaf == commitment, "Path does not match registration");
  assert(
    consents.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))),
    "Registration not found"
  );
}

export circuit register(studyId: Bytes<32>): [] {
  // Only the hiding commitment is published; studyId stays private.
  consents.insert(disclose(commitmentOf(studyId)));
  registrations.increment(1);
}

export circuit prove(studyId: Bytes<32>, challenge: Bytes<32>): [] {
  assertRegistered(studyId);

  // Not revoked. The membership query necessarily reveals the tag (never the leaf).
  const tag = revocationTag(studyId);
  assert(!revoked.member(disclose(tag)), "Consent revoked");

  // One-time challenge.
  assert(!answered.member(disclose(challenge)), "Challenge already answered");
  answered.insert(disclose(challenge), disclose(studyId));
}

export circuit revoke(studyId: Bytes<32>): [] {
  // Only a holder of the secret with a real registration can revoke.
  assertRegistered(studyId);
  revoked.insert(disclose(revocationTag(studyId)));
}
