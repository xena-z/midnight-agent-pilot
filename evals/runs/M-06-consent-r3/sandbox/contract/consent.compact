pragma language_version >= 0.28;

import CompactStandardLibrary;

// Privacy-preserving consent registry (demo only, no real data).

export ledger consents: HistoricMerkleTree<10, Bytes<32>>;
export ledger revoked: Set<Bytes<32>>;
export ledger answered: Map<Bytes<32>, Bytes<32>>;
export ledger registrations: Counter;

witness consentSecret(): Bytes<32>;
witness consentRandomness(): Bytes<32>;
witness consentPath(commitment: Bytes<32>): MerkleTreePath<10, Bytes<32>>;

// Leaf stored in the tree: hides studyId, secret and randomness.
circuit commitmentFor(studyId: Bytes<32>, secret: Bytes<32>, rand: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>(
    [pad(32, "consent:commit:"), studyId, secret, rand]
  );
}

// Per (participant, study) revocation tag. Needs the secret, so nobody else can
// compute it, and it is unrelated to the leaf, so it doesn't reveal the leaf.
circuit revocationTag(studyId: Bytes<32>, secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "consent:revoke:"), studyId, secret]
  );
}

// Proves (privately) that the caller's registration for studyId is in the tree.
circuit assertRegistered(studyId: Bytes<32>): Bytes<32> {
  const secret = consentSecret();
  const leaf = commitmentFor(studyId, secret, consentRandomness());
  const path = consentPath(leaf);
  assert(
    consents.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))),
    "Consent not registered"
  );
  // The path must actually be for this leaf.
  assert(path.leaf == leaf, "Path does not match registration");
  return revocationTag(studyId, secret);
}

export circuit register(studyId: Bytes<32>): [] {
  const leaf = commitmentFor(studyId, consentSecret(), consentRandomness());
  // Only the opaque commitment becomes public.
  consents.insert(disclose(leaf));
  registrations.increment(1);
}

export circuit prove(studyId: Bytes<32>, challenge: Bytes<32>): [] {
  const tag = assertRegistered(studyId);
  // Revocation check: reveals only the tag (not the leaf/registration position).
  assert(!revoked.member(disclose(tag)), "Consent revoked");
  assert(!answered.member(disclose(challenge)), "Challenge already answered");
  answered.insert(disclose(challenge), disclose(studyId));
}

export circuit revoke(studyId: Bytes<32>): [] {
  const tag = assertRegistered(studyId);
  assert(!revoked.member(disclose(tag)), "Already revoked");
  revoked.insert(disclose(tag));
}
