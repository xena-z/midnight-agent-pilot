pragma language_version >= 0.16;

import CompactStandardLibrary;

enum Phase { commit, reveal }

witness secretKey(): Bytes<32>;
witness myVote(): Boolean;
witness voteSalt(): Bytes<32>;

export ledger phase: Phase;
export ledger admin: Bytes<32>;
export ledger yes: Counter;
export ledger no: Counter;
ledger commitments: Map<Bytes<32>, Bytes<32>>;
ledger revealed: Set<Bytes<32>>;

export pure circuit publicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "sealed-vote:pk:"), sk]);
}

// Salted commitment to the vote; the salt hides the single bit.
circuit computeCommitment(pk: Bytes<32>, vote: Boolean, salt: Bytes<32>): Bytes<32> {
  const v: Bytes<32> = vote ? pad(32, "yes") : pad(32, "no");
  return persistentHash<Vector<4, Bytes<32>>>([pad(32, "sealed-vote:cm:"), pk, v, salt]);
}

constructor() {
  admin = disclose(publicKey(secretKey()));
  phase = Phase.commit;
}

export circuit commitVote(): [] {
  assert(phase == Phase.commit, "Not in commit phase");
  const pk = publicKey(secretKey());
  assert(!commitments.member(disclose(pk)), "Already committed");
  const c = computeCommitment(pk, myVote(), voteSalt());
  commitments.insert(disclose(pk), disclose(c));
}

export circuit closeCommits(): [] {
  assert(phase == Phase.commit, "Not in commit phase");
  assert(publicKey(secretKey()) == admin, "Only admin");
  phase = Phase.reveal;
}

export circuit revealVote(): [] {
  assert(phase == Phase.reveal, "Not in reveal phase");
  const pk = publicKey(secretKey());
  const dpk = disclose(pk);
  assert(commitments.member(dpk), "No commitment");
  assert(!revealed.member(dpk), "Already revealed");
  const vote = myVote();
  const c = computeCommitment(pk, vote, voteSalt());
  assert(commitments.lookup(dpk) == c, "Vote does not match commitment");
  revealed.insert(dpk);
  if (disclose(vote)) {
    yes.increment(1);
  } else {
    no.increment(1);
  }
}
