pragma language_version >= 0.16;

import CompactStandardLibrary;

witness secretKey(): Bytes<32>;

// Nullifiers of secret keys that have claimed. Derived with a different
// domain separator than the public key, so it cannot be linked to it.
export ledger nullifiers: Set<Bytes<32>>;
export ledger claims: Counter;

export pure circuit publicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "claim:pk:"), sk]);
}

circuit nullifier(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "claim:nf:"), sk]);
}

export circuit claim(): [] {
  const nf = nullifier(secretKey());
  assert(!nullifiers.member(disclose(nf)), "Already claimed");
  nullifiers.insert(disclose(nf));
  claims.increment(1);
}
