pragma language_version >= 0.18;

import CompactStandardLibrary;

// A simple fungible token with balances kept on the public ledger.

// Public state: anyone can read all of it.
export ledger totalSupply: Uint<64>;
export ledger balances: Map<Bytes<32>, Uint<64>>;
export ledger admin: Bytes<32>;

// The caller's secret key, supplied privately by the caller's own machine.
witness secretKey(): Bytes<32>;

// Account address derived from a secret key.
export pure circuit publicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "token:pk:"), sk]);
}

// The deployer becomes the admin.
constructor() {
  admin = disclose(publicKey(secretKey()));
  totalSupply = 0;
}

// Current balance of an account, 0 if it has none.
export circuit balanceOf(account: Bytes<32>): Uint<64> {
  const a = disclose(account);
  return balances.member(a) ? balances.lookup(a) : 0;
}

// Admin-only: create `amount` new tokens in account `to`.
export circuit mint(to: Bytes<32>, amount: Uint<64>): [] {
  const caller = publicKey(secretKey());
  assert(caller == admin, "Only the admin can mint");

  const dest = disclose(to);
  const amt = disclose(amount);

  // Uint<64> casts fail the transaction on overflow, keeping the sums exact.
  const newSupply = (totalSupply + amt) as Uint<64>;
  const newBalance = (balanceOf(dest) + amt) as Uint<64>;

  balances.insert(dest, newBalance);
  totalSupply = newSupply;
}

// Move `amount` from the caller's account to `to`. Supply is unchanged.
export circuit transfer(to: Bytes<32>, amount: Uint<64>): [] {
  const sender = disclose(publicKey(secretKey()));
  const dest = disclose(to);
  const amt = disclose(amount);

  const fromBalance = balanceOf(sender);
  assert(fromBalance >= amt, "Insufficient balance");

  // Debit first, then read the destination, so a self-transfer is a no-op.
  balances.insert(sender, (fromBalance - amt) as Uint<64>);
  balances.insert(dest, (balanceOf(dest) + amt) as Uint<64>);
}

// Destroy `amount` from the caller's account and from the total supply.
export circuit burn(amount: Uint<64>): [] {
  const sender = disclose(publicKey(secretKey()));
  const amt = disclose(amount);

  const fromBalance = balanceOf(sender);
  assert(fromBalance >= amt, "Insufficient balance");

  balances.insert(sender, (fromBalance - amt) as Uint<64>);
  totalSupply = (totalSupply - amt) as Uint<64>;
}
