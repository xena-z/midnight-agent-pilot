pragma language_version >= 0.20;

import CompactStandardLibrary;

// Public ledger state
export ledger admin: Bytes<32>;
export ledger totalSupply: Uint<64>;
export ledger balances: Map<Bytes<32>, Uint<64>>;

witness secretKey(): Bytes<32>;

// Account address derived from a secret key.
export pure circuit publicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "token:pk:"), sk]);
}

constructor() {
  admin = disclose(publicKey(secretKey()));
  totalSupply = 0;
}

export circuit balanceOf(account: Bytes<32>): Uint<64> {
  const a = disclose(account);
  return balances.member(a) ? balances.lookup(a) : 0;
}

export circuit mint(to: Bytes<32>, amount: Uint<64>): [] {
  const caller = publicKey(secretKey());
  assert(disclose(caller == admin), "Only the admin can mint");
  const t = disclose(to);
  const amt = disclose(amount);
  const newTotal = (totalSupply + amt) as Uint<64>;  // fails on Uint<64> overflow
  const current: Uint<64> = balances.member(t) ? balances.lookup(t) : 0;
  balances.insert(t, (current + amt) as Uint<64>);
  totalSupply = newTotal;
}

export circuit transfer(to: Bytes<32>, amount: Uint<64>): [] {
  const caller = disclose(publicKey(secretKey()));
  const t = disclose(to);
  const amt = disclose(amount);
  const callerBal: Uint<64> = balances.member(caller) ? balances.lookup(caller) : 0;
  assert(callerBal >= amt, "Insufficient balance");
  // Debit first so a self-transfer leaves the balance unchanged.
  balances.insert(caller, (callerBal - amt) as Uint<64>);
  const toBal: Uint<64> = balances.member(t) ? balances.lookup(t) : 0;
  balances.insert(t, (toBal + amt) as Uint<64>);
}

export circuit burn(amount: Uint<64>): [] {
  const caller = disclose(publicKey(secretKey()));
  const amt = disclose(amount);
  const callerBal: Uint<64> = balances.member(caller) ? balances.lookup(caller) : 0;
  assert(callerBal >= amt, "Insufficient balance");
  balances.insert(caller, (callerBal - amt) as Uint<64>);
  totalSupply = (totalSupply - amt) as Uint<64>;
}
