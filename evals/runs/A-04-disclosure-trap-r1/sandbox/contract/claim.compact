pragma language_version >= 0.16;

import CompactStandardLibrary;

// Nullifiers of secret keys that have already claimed.
// A nullifier is derived with a different domain separator than the public
// key, so it cannot be linked to any publicly known public key.
export ledger nullifiers: Set<Bytes<32>>;
export ledger claims: Counter;

witness secretKey(): Bytes<32>;

export pure circuit publicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "claim:pk:"), sk]);
}

circuit claimNullifier(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "claim:nullifier:"), sk]);
}

export circuit claim(): [] {
  const sk = secretKey();
  const nf = disclose(claimNullifier(sk));
  assert(!nullifiers.member(nf), "Reward already claimed");
  nullifiers.insert(nf);
  claims.increment(1);
}
