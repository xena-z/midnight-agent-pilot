pragma language_version >= 0.28;

import CompactStandardLibrary;

export enum Phase { commit, reveal }

witness secretKey(): Bytes<32>;
witness myVote(): Boolean;
witness voteSalt(): Bytes<32>;

export ledger admin: Bytes<32>;
export ledger phase: Phase;
export ledger commitments: Map<Bytes<32>, Bytes<32>>;
export ledger revealed: Set<Bytes<32>>;
export ledger yes: Counter;
export ledger no: Counter;

export pure circuit publicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "sealed-vote:pk:"), sk]);
}

constructor() {
  admin = disclose(publicKey(secretKey()));
  phase = Phase.commit;
}

// Commitment hides the vote: the salt is secret random data, so the
// commitment reveals nothing about the vote until the voter opens it.
circuit voteCommitment(): Bytes<32> {
  return persistentCommit<Boolean>(myVote(), voteSalt());
}

export circuit commitVote(): [] {
  assert(phase == Phase.commit, "Not in commit phase");
  const pk = publicKey(secretKey());
  assert(!commitments.member(disclose(pk)), "Already committed");
  commitments.insert(disclose(pk), disclose(voteCommitment()));
}

export circuit closeCommits(): [] {
  assert(phase == Phase.commit, "Not in commit phase");
  assert(publicKey(secretKey()) == admin, "Only admin can close commits");
  phase = Phase.reveal;
}

export circuit revealVote(): [] {
  assert(phase == Phase.reveal, "Not in reveal phase");
  const pk = disclose(publicKey(secretKey()));
  assert(commitments.member(pk), "No commitment found");
  assert(!revealed.member(pk), "Already revealed");
  assert(commitments.lookup(pk) == disclose(voteCommitment()), "Vote does not match commitment");
  revealed.insert(pk);
  const v = disclose(myVote());
  if (v) {
    yes.increment(1);
  } else {
    no.increment(1);
  }
}
